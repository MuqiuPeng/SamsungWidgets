<?xml version="1.0" encoding="utf-8"?>
<!--
  磨砂玻璃背景。桌面小工具拿不到身后的壁纸，没法真正模糊，
  这里用半透明底色 + 顶部高光 + 细描边模拟玻璃质感；深色模式的颜色在 values-night。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/glass_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_sheen"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
